    {
      "parameters": {
        "jsCode": "const data = $input.first().json\nconst num = v => Number(v ?? 0)\nconst round2 = v => Math.round(v * 100) / 100\nconst PAYMENT_STATUSES = ['FULL','REFUNDED','PARTIAL','DEPOSIT']\n\nlet rows = []\nlet issues =[]\nlet income = 0, commissions = 0, refunds = 0\n\nfor(const p of data.payments) {\n  const date = p.createdAt.slice(0,10)\n\n  if(PAYMENT_STATUSES.includes(p.paymentStatus)) {\n    income += num(p.amountPaid)\n    commissions += num(p.commission)\n    rows.push({ Date: date, Type: 'Income', Reservation: p.reservationRef,\n                Amount: num(p.amountPaid), Method: p.paymentMethod, Note: p.paymentStatus })\n    if(num(p.commission) > 0) \n      rows.push({ Date: date, Type: 'Commission', Reservation: p.reservationRef,\n                  Amount: -num(p.commission), Method: p.paymentMethod, Note: 'Platform/Stripe fee' })\n  }\n  \n  if(p.paymentStatus== \"FAILED\" || p.paymentStatus== \"PENDING\") \n    issues.push(`${p.reservationRef}: payment ${p.paymentStatus}`)\n  if(num(p.amountPaid) > num(p.amountPaid)) \n    issues.push(`${p.reservationRef}: paid more than expected`)\n  if('stripePaymentIntentId' in p && p.paymentMethod === 'STRIPE' && num(p.amountPaid > 0) && !p.stripePaymentIntentId) \n    issues.push(`${p.reservationRef}: Stripe payment without payment intent ID`)\n}\n\nfor (const r of data.refunds) {\n  refunds += num(r.amountRefunded);\n  rows.push({ Date: r.createdAt.slice(0, 10), Type: 'Refund', Reservation: r.reservationRef,\n              Amount: -num(r.amountRefunded), Method: r.refundMethod, Note: r.reason });\n  if (r.refundMethod === 'STRIPE' && !r.stripeRefundId)\n    issues.push(`${r.reservationRef}: Stripe refund without refund ID`);\n}\n\nreturn [{\n  json: {\n    month:data.month,\n    refunds: round2(refunds),\n    commissions: round2(commissions),\n    income: round2(income),\n    net: round2(income - refunds - commissions),\n    issues,\n    rows\n  }\n}]"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -112,
        0
      ],
